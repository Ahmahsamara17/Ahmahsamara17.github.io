---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);

const videoModules = import.meta.glob("../../content/works/*.{webm,mp4}", {
  eager: true,
  query: "?url",
  import: "default",
});

const videoSources = Object.fromEntries(
  Object.entries(videoModules).map(([path, url]) => [
    path.split("/").pop(),
    url,
  ]),
);

const artifactModules = import.meta.glob(
  "../../content/works/*.{bin,doc,docx,pdf,ps1,py,txt,vba,zip}",
  {
    eager: true,
    query: "?url&no-inline",
    import: "default",
  },
);

const artifactSources = Object.fromEntries(
  Object.entries(artifactModules).map(([path, url]) => [
    path.split("/").pop(),
    url,
  ]),
);
---

<Layout title={`${work.data.title} | Sammy`}>
  <div class="work-page">
    <a class="back-link" href="works/">← All works</a>

    <article class="work-article">
      <div class="work-meta">
        <time datetime={work.data.date}>{work.data.date}</time>
        {work.data.status === "draft" && <span class="status-badge">Work in progress</span>}
      </div>

      {work.data.status === "draft" && (
        <p class="work-progress-note">
          This analysis is still in progress. I’m publishing my notes as I work through the sample.
        </p>
      )}

      <div class="work-body">
        <Content />
      </div>
    </article>
  </div>

  <script define:vars={{ videoSources, artifactSources }}>
    document.querySelectorAll("video[data-work-video]").forEach((element) => {
      if (!(element instanceof HTMLVideoElement)) return;

      const filename = element.dataset.workVideo;
      const source = filename ? videoSources[filename] : undefined;
      if (source) element.src = source;
    });

    document.querySelectorAll("a[data-work-download]").forEach((element) => {
      if (!(element instanceof HTMLAnchorElement)) return;

      const filename = element.dataset.workDownload;
      const source = filename ? artifactSources[filename] : undefined;
      if (!source || !filename) return;

      element.href = source;
      element.download = filename;
    });

    const findCodeBlock = (element, direction) => {
      let sibling = element[direction];
      while (sibling) {
        if (sibling instanceof HTMLPreElement) return sibling;
        sibling = sibling[direction];
      }
      return undefined;
    };

    document.querySelectorAll("[data-code-comparison]").forEach((marker) => {
      const original = findCodeBlock(marker, "previousElementSibling");
      const renamed = findCodeBlock(marker, "nextElementSibling");
      if (!original || !renamed) return;

      const wrapper = document.createElement("div");
      wrapper.className = "code-comparison-wrapper";

      const toggle = document.createElement("button");
      toggle.className = "code-comparison-toggle";
      toggle.type = "button";

      let showingRenamed = true;
      const updateVersion = () => {
        original.hidden = showingRenamed;
        renamed.hidden = !showingRenamed;
        toggle.textContent = showingRenamed ? "no name" : "name";
        toggle.setAttribute("aria-pressed", String(showingRenamed));
      };

      toggle.addEventListener("click", () => {
        showingRenamed = !showingRenamed;
        updateVersion();
      });

      marker.replaceWith(wrapper);
      wrapper.append(original, renamed, toggle);
      updateVersion();
    });
  </script>
</Layout>
